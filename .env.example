# Copy this template to .env in the cryoFlake project root, or set
# CRYOFLAKE_ENV_FILE to an explicit file path when using an installed package.
# Existing process environment variables take precedence over .env values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, for temporary credentials:
AWS_SESSION_TOKEN=
# Optional, for S3-compatible services (leave blank for Amazon S3):
CRYOFLAKE_S3_ENDPOINT_URL=
CRYOFLAKE_S3_REGION=
# Standard AWS_REGION / AWS_DEFAULT_REGION and AWS_ENDPOINT_URL_S3 /
# AWS_ENDPOINT_URL are also supported when cryoFlake-specific values are unset.
